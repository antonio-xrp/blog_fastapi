# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.

# --- App ---
DATABASE_URL=postgresql+psycopg://blog_user:cambia-esto@localhost:5432/fastapi_blog
SECRET_KEY=genera-una-clave-larga-y-aleatoria
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# RESET_TOKEN_EXPIRE_MINUTES=60
# POSTS_PER_PAGE=10
# MAX_UPLOAD_SIZE_BYTES=5242880
FRONTEND_URL=http://localhost:8000

# --- Correo (recuperación de contraseña) ---
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true

# --- Docker Compose (servicio db) ---
POSTGRES_DB=fastapi_blog
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=cambia-esto

# --- Tests (base PostgreSQL aparte) ---
TEST_DATABASE_URL=postgresql+psycopg://blog_user:cambia-esto@localhost:5432/fastapi_blog_test
